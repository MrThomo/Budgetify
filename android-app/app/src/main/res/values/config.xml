<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Google "Web application" OAuth client ID used for Sign in with Google (single sign-on).
      Firebase console -> Authentication -> Sign-in method -> Google -> Web SDK configuration
      -> "Web client ID". Leave the REPLACE text in place to hide SSO at runtime.
    -->
    <string name="google_web_client_id" translatable="false">REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com</string>
</resources>
